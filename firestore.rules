rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Who is logged in (the dashboard creates the member account automatically;
    // the backup account is created from Settings → "Create backup account")
    function signedIn() { return request.auth != null; }
    function isAdmin()  { return signedIn() && request.auth.token.email == 'unique122022@gmail.com'; }
    function isBackup() { return signedIn() && request.auth.token.email == 'backup@unique-twelve.app'; }
    function isMember() { return signedIn() && request.auth.token.email == 'members@unique-twelve.app'; }
    function canView()  { return isAdmin() || isMember() || isBackup(); }

    // Uploaded files: ID cards are private (admin + backup only); other documents members can view
    match /blobs/{id} {
      allow read: if isAdmin() || isBackup() || (isMember() && resource.data.private == false);
      allow write: if isAdmin();
    }

    // Activity log: everyone logged in can read it; only the admin can add entries; nobody can edit or delete
    match /activity/{id} {
      allow read: if canView();
      allow create: if isAdmin();
    }

    // Everything else (members, payments, banks, FDR, income, expenses, assets, resolution, settings):
    // members can view, only the admin can add / edit / delete. Nothing is visible without a password.
    match /{collection}/{id} {
      allow read: if canView() && collection != 'blobs' && collection != 'activity';
      allow write: if isAdmin() && collection != 'blobs' && collection != 'activity';
    }
  }
}
